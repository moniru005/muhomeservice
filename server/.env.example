PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=mu_home_service
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
ADMIN_NAME=MU Home Service Admin
ADMIN_EMAIL=admin@muhomeservice.com
ADMIN_PASSWORD=ChangeThisStrongPassword123!

# Password reset email (SMTP)
FRONTEND_URL=http://localhost:5173
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
MAIL_FROM=MU Home Service <no-reply@example.com>

# Public URL used in Media Library image links
PUBLIC_API_URL=http://localhost:5000

# bKash Tokenized Checkout (sandbox by default; merchant approval required for production).
PAYMENT_PROVIDER=bkash
PAYMENT_CURRENCY=BDT
BKASH_ENV=sandbox
# Optional override; normally omit and let BKASH_ENV select the official base URL.
BKASH_BASE_URL=
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
# Exact public callback endpoint, e.g. https://api.example.com/api/payments/bkash/callback
PAYMENT_PUBLIC_CALLBACK_URL=

# Generic payment adapter is retained as an alternative provider contract.
PAYMENT_CREATE_URL=
PAYMENT_REFUND_URL=
PAYMENT_API_TOKEN=
PAYMENT_WEBHOOK_SECRET=

# Bangladesh SMS gateway: MiMSMS transactional SMS adapter.
SMS_PROVIDER=mimsms
MIMSMS_API_URL=https://api.mimsms.com/api/V2/SMS
MIMSMS_USERNAME=
MIMSMS_API_KEY=
MIMSMS_SENDER_NAME=
# Generic SMS adapter is retained as an alternative.
SMS_API_URL=
SMS_API_TOKEN=
SMS_SENDER_ID=

# Optional WhatsApp Business/provider API adapter (provider must accept {to, message, context})
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=

# Warranty period applied after OTP-verified completion
DEFAULT_WARRANTY_DAYS=30
