PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=mu_home_service
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
ADMIN_NAME=MU Home Service Admin
ADMIN_EMAIL=admin@muhomeservice.com
ADMIN_PASSWORD=ChangeThisStrongPassword123!

# Password reset email (SMTP)
FRONTEND_URL=http://localhost:5173
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
MAIL_FROM=MU Home Service <no-reply@example.com>

# Public URL used in Media Library image links
PUBLIC_API_URL=http://localhost:5000
